sh B":{"link":"/ib-spanish-b/","subjects":[{"id":"cbf6790a-a406-4b7c-8481-aed845b275d4","name":"SL","link":"/ib-spanish-b/sl/past-papers/","content":{"predictionExams":null,"mockExams":null,"topics":null},"statuses":{"predictionExams":null,"questionbank":null,"pastPapers":"visible","flashcards":null,"summaryNotes":null,"mockExams":null,"popularQuizzes":null,"keyConcepts":null}},{"id":"9b795610-e843-4988-9a9e-78353d0f009d","name":"HL","link":"/ib-spanish-b/hl/past-papers/","content":{"predictionExams":null,"mockExams":null,"topics":null},"statuses":{"predictionExams":null,"questionbank":null,"pastPapers":"visible","flashcards":null,"summaryNotes":null,"mockExams":null,"popularQuizzes":null,"keyConcepts":null}}]},"French B":{"link":"/ib-french-b/","subjects":[{"id":"0f7b154a-db1b-40e3-91a1-04f56eb45e96","name":"SL","link":"/ib-french-b/sl/past-papers/","content":{"predictionExams":null,"mockExams":null,"topics":null},"statuses":{"predictionExams":null,"questionbank":null,"pastPapers":"visible","flashcards":null,"summaryNotes":null,"mockExams":null,"popularQuizzes":null,"keyConcepts":null}},{"id":"c2e2c1ad-ddf9-41b1-b004-d942d8eaec6c","name":"HL","link":"/ib-french-b/hl/past-papers/","content":{"predictionExams":null,"mockExams":null,"topics":null},"statuses":{"predictionExams":null,"questionbank":null,"pastPapers":"visible","flashcards":null,"summaryNotes":null,"mockExams":null,"popularQuizzes":null,"keyConcepts":null}}]},"Ab Initio":{"link":"/ib-ab-initio/","subjects":[]}},"IB Core":{"Theory of Knowledge":{"link":"/ib-theory-of-knowledge/","subjects":[{"id":"efedcb25-6d2d-44d0-ab82-05ca7f5fe03b","name":"ToK","link":"/ib-theory-of-knowledge/tok/past-papers/","content":{"predictionExams":null,"mockExams":null,"topics":null},"statuses":{"predictionExams":null,"questionbank":null,"pastPapers":"visible","flashcards":null,"summaryNotes":null,"mockExams":null,"popularQuizzes":null,"keyConcepts":null}}]}}},"seoContent":{"_createdAt":"2026-10-04T21:10:13Z","_id":"106f986d-8a62-46ba-a042-bea6c3bfcccd","_rev":"VGfwi072KJdK3LSnlqSyQP","_type":"seoContent","_updatedAt":"2026-10-04T21:13:04Z","content":null,"entityType":"feature_page_past_papers","faqItems":[{"_key":"ed7626512dd7","_type":"faqItem","answer":[{"_key":"2f10f95fcd4e","_type":"block","children":[{"_key":"bfca35613cd6","_type":"span","marks":[],"text":"Each year, in either May or November, IB students around the world sit their end of IB Diploma Program (IBDP) final exams. Once these exams are held, the exam papers (called “Past Papers” after the exams have completed) can be used by future students to prepare for their final exams (and so on after that). Hence, Past Papers are exam papers from prior years, sat by students who undertook the relevant IB Mathematics or Science course. IB Past Papers are also commonly used as practice exams in IB Schools."}],"markDefs":[],"style":"normal"}],"question":"What are IB Past Papers?"},{"_key":"99b9b0c0c7f0","_type":"faqItem","answer":[{"_key":"2dc8f5668d46","_type":"block","children":[{"_key":"22e1e2e39afc","_type":"span","marks":[],"text":"Utilising IB Past Papers is an effective strategy to prepare for final exams, as it provides students with guidance on the types of questions they will encounter, and the length and difficulty of the exam papers. IB exams given previously can allow you to determine how you might fare on your exams if they were given today, or allow you to study for an upcoming test on part of the material. If you are an IB student preparing for your upcoming exams, it’s recommended that one of your revision techniques is reviewing and practicing Past Papers."}],"markDefs":[],"style":"normal"}],"question":"Should I use IB Past Papers to revise for my exams?"},{"_key":"04288e0d3c31","_type":"faqItem","answer":[{"_key":"c072b9b89e54","_type":"block","children":[{"_key":"e5ef71b67424","_type":"span","marks":[],"text":"A common difficulty IB students encounter when revising with IB Past Papers is how to actually answer the exam questions. In addition, the official mark schemes accompanying the papers are often difficult to understand, or don’t show all the working steps on how to reach the final answer (the mark schemes are designed for the markers of exams, not the students). Revision Village supports IB students by providing high quality video tutorials to every IB Past Paper question, including all sub parts. The video tutorials to the Past Papers are taught by experienced and expert IB teachers who are passionate about teaching concepts in a simple, intuitive and engaging manner."}],"markDefs":[],"style":"normal"}],"question":"How does Revision Village support IB Past Paper Revision?"},{"_key":"db8942ef8463","_type":"faqItem","answer":[{"_key":"514bc4e99f99","_type":"block","children":[{"_key":"a61ce5bc790b","_type":"span","marks":[],"text":"It is likely that your school will have access to all of the IB Past Exams. It is therefore recommended that students ask their teacher or IB Coordinator for copies of the exam papers and mark schemes. Alternately, Past Papers can be purchased from the Follett IB online store or commonly found by searching IB Resources Past Papers in google search."}],"markDefs":[],"style":"normal"}],"question":"Where can I get PDF copies of IB Past Papers?"},{"_key":"156708256f6f","_type":"faqItem","answer":[{"_key":"1263741fc4f9","_type":"block","children":[{"_key":"668409349926","_type":"span","marks":[],"text":"In the IB Past Papers sections for each course, you will find full worked solutions to the questions asked on previous IB Math AI HL, IB Math AA HL, IB Math AA SL, IB Math AI SL, IB Chemistry HL, IB Chemistry SL, IB Biology HL and IB Biology SL, IB Physics HL and IB Physics SL Exams. Within each video, an experienced IB teacher will guide you through the solution, step-by-step."}],"markDefs":[],"style":"normal"}],"question":"For which courses are there IB Past Paper Solution Videos?"}],"title":"Feature Page - Past Papers"}},"__N_SSG":true}